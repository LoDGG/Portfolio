---
import type { Locale } from '../config/site';
import { site } from '../config/site';
import { localizedPath } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import type { Project } from '../lib/projects';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from './ProjectCard.astro';

interface Props {
	locale: Locale;
	projects: Project[];
}

const { locale, projects } = Astro.props;
const t = useTranslations(locale);
const spotlightProject = projects.find((project) => project.data.spotlight);
const standardProjects = projects.filter((project) => project !== spotlightProject);

const capabilities = [
	t.capabilityAiSystems,
	t.capabilityAutomation,
	t.capabilityDataInfra,
	t.capabilityDelivery,
];

const ecosystem = [
	'Python',
	'TypeScript',
	'Astro',
	'LLM / RAG',
	'MCP',
	'SQL',
	'Grafana',
	'APIs',
];
---

<BaseLayout locale={locale} title={site.title} alternatePath="/">
	<section class="hero">
		<h1>{site.identity.headline}</h1>
		<p class="lead">{site.description}</p>
		<div class="hero-actions">
			<a class="action-link" href="#selected-work">{t.selectedWork}</a>
			<a class="text-link" href="#contact">{t.contact}</a>
		</div>
	</section>

	<section class="page-section" aria-labelledby="selected-work">
		<div class="section-header">
			<p class="eyebrow">{t.evidenceFirst}</p>
			<h2 id="selected-work">{t.selectedWork}</h2>
			<p>{t.selectedWorkIntro}</p>
		</div>
		{
			projects.length > 0 ? (
				<div class="project-list project-list--featured">
					{spotlightProject && <ProjectCard project={spotlightProject} locale={locale} headingLevel="h3" spotlight />}
					{standardProjects.map((project) => <ProjectCard project={project} locale={locale} headingLevel="h3" />)}
				</div>
			) : (
				<p>{t.noProjects}</p>
			)
		}
		<a class="text-link" href={localizedPath(locale, '/projects/')}>{t.allProjects}</a>
	</section>

	<section class="page-section section-grid" aria-labelledby="capabilities">
		<div class="section-header">
			<p class="eyebrow">{t.capabilitiesEyebrow}</p>
			<h2 id="capabilities">{t.capabilities}</h2>
		</div>
		<ul class="compact-list">
			{capabilities.map((capability) => <li>{capability}</li>)}
		</ul>
	</section>

	<section class="page-section section-grid" aria-labelledby="background">
		<div class="section-header">
			<p class="eyebrow">{t.backgroundEyebrow}</p>
			<h2 id="background">{t.background}</h2>
		</div>
		<p>{t.backgroundSummary}</p>
	</section>

	<section class="page-section section-grid" aria-labelledby="ecosystem">
		<div class="section-header">
			<p class="eyebrow">{t.ecosystemEyebrow}</p>
			<h2 id="ecosystem">{t.ecosystem}</h2>
		</div>
		<ul class="inline-list">
			{ecosystem.map((item) => <li>{item}</li>)}
		</ul>
	</section>

	<section class="page-section section-grid" aria-labelledby="contact">
		<div class="section-header">
			<p class="eyebrow">{t.contactEyebrow}</p>
			<h2 id="contact">{t.contact}</h2>
		</div>
		<div class="hero-actions">
			{site.identity.email && <a class="text-link" href={`mailto:${site.identity.email}`}>{t.email}</a>}
			{site.identity.linkedin && <a class="text-link" href={site.identity.linkedin}>{t.linkedin}</a>}
		</div>
	</section>
	<footer class="page-note"><p>{t.privacyNotice}</p></footer>
</BaseLayout>
