---
import type { Locale } from '../config/site';
import { useTranslations } from '../i18n/ui';

interface Props { steps: string[]; locale: Locale; }
const { steps, locale } = Astro.props;
const t = useTranslations(locale);
---

<figure class="architecture-flow">
	<figcaption>{t.architectureFlow}</figcaption>
	<ol aria-label={t.architectureFlow}>
		{steps.map((step) => <li><span>{step}</span></li>)}
	</ol>
</figure>

<style>
	.architecture-flow { display: grid; grid-template-columns: minmax(10rem, 1fr) minmax(0, 2fr); gap: var(--space-8); margin: 0 0 var(--space-8); padding: var(--space-6); border: 1px solid var(--color-line); background: var(--color-surface-muted); }
	.architecture-flow figcaption { color: var(--color-accent); font: 600 var(--type-meta) var(--font-mono); letter-spacing: .04em; text-transform: uppercase; }
	.architecture-flow ol { display: grid; gap: var(--space-4); margin: 0; padding: 0; list-style: none; counter-reset: flow; }
	.architecture-flow li { position: relative; display: flex; align-items: center; gap: var(--space-4); padding: var(--space-3) var(--space-4); background: var(--color-surface); border-left: 2px solid var(--color-accent); counter-increment: flow; line-height: 1.4; }
	.architecture-flow li::before { content: counter(flow, decimal-leading-zero); flex-shrink: 0; color: var(--color-accent); font: 600 var(--type-meta) var(--font-mono); }
	.architecture-flow li:not(:last-child)::after { content: '↓'; position: absolute; left: var(--space-4); bottom: -1.1rem; color: var(--color-accent); font-size: 1rem; line-height: 1; }
	@media (max-width: 48rem) { .architecture-flow { grid-template-columns: 1fr; gap: var(--space-4); padding: var(--space-4); } }
</style>
