---
import type { Project } from '../lib/projects';
import type { Locale } from '../config/site';
import { projectPath } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

interface Props {
	project: Project;
	locale: Locale;
}

const { project, locale } = Astro.props;
const t = useTranslations(locale);
---

<article class="project-card">
	<p class="eyebrow">{project.data.year} / {project.data.role}</p>
	<h2><a href={projectPath(locale, project.data.slug)}>{project.data.title}</a></h2>
	<p>{project.data.summary}</p>
	<p class="project-card__meta">{project.data.stack.join(' / ')}</p>
	<a class="text-link" href={projectPath(locale, project.data.slug)}>{t.viewProject}</a>
</article>
