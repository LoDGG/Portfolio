---
interface Metric {
	value: string;
	label: string;
	note?: string;
}

interface Props {
	metrics?: Metric[];
}

const { metrics = [] } = Astro.props;
---

{
	metrics.length > 0 && (
		<div class="metric-list" aria-label="Impact metrics">
			{metrics.map((metric) => (
				<div class="metric">
					<strong>{metric.value}</strong>
					<span>{metric.label}</span>
					{metric.note && <small>{metric.note}</small>}
				</div>
			))}
		</div>
	)
}
