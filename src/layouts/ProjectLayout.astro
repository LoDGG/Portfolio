---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import type { Locale } from '../config/site';
import { localizedPath } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

interface Props {
	project: CollectionEntry<'projects'>;
	locale: Locale;
}

const { project, locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout
	locale={locale}
	title={project.data.title}
	description={project.data.summary}
	alternatePath={`/projects/${project.data.slug}/`}
>
	<a class="text-link" href={localizedPath(locale, '/projects/')}>{t.backToProjects}</a>
	<section class="hero">
		<p class="eyebrow">{t.projectOverview}</p>
		<h1>{project.data.title}</h1>
		<p>{project.data.summary}</p>
	</section>
	<section class="project-meta" aria-label={t.projectOverview}>
		<p><strong>{t.role}</strong><br />{project.data.role}</p>
		<p><strong>{t.year}</strong><br />{project.data.year}</p>
		<p><strong>{t.stack}</strong><br />{project.data.stack.join(' / ')}</p>
		<p><strong>{t.confidentiality}</strong><br />{project.data.confidentiality}</p>
	</section>
	<section class="content-section">
		<slot />
	</section>
</BaseLayout>
