---
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { site, type Locale } from '../config/site';
import { localizedPath } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

interface Props {
	title?: string;
	description?: string;
	locale: Locale;
	alternatePath?: string;
}

const {
	title = site.title,
	description = site.description,
	locale,
	alternatePath = '/',
} = Astro.props;
const pageTitle = title === site.title ? title : `${title} | ${site.title}`;
const t = useTranslations(locale);
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content={site.privacy.robots} />
		<meta name="referrer" content={site.privacy.referrer} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href={localizedPath(locale)}>{site.name}</a>
			<nav class="primary-nav" aria-label="Primary">
				<a href={localizedPath(locale)}>{t.home}</a>
				<a href={localizedPath(locale, '/projects/')}>{t.projects}</a>
			</nav>
			<LanguageSwitcher locale={locale} path={alternatePath} />
		</header>
		<main>
			<slot />
		</main>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light;
		--color-bg: #fafafa;
		--color-text: #1f2933;
		--color-muted: #5f6b7a;
		--color-line: #d9dee5;
		--color-accent: #245c73;
		--space-page: clamp(1rem, 4vw, 3rem);
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background: var(--color-bg);
		color: var(--color-text);
		line-height: 1.6;
	}

	a {
		color: inherit;
	}

	main {
		width: min(100% - (2 * var(--space-page)), 64rem);
		margin: 0 auto;
		padding: 3rem 0 5rem;
	}

	.site-header {
		display: grid;
		grid-template-columns: 1fr auto auto;
		gap: 1rem;
		align-items: center;
		padding: 1rem var(--space-page);
		border-bottom: 1px solid var(--color-line);
	}

	.brand {
		font-weight: 700;
		text-decoration: none;
	}

	.primary-nav,
	.language-switcher {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		color: var(--color-muted);
		font-size: 0.95rem;
	}

	.primary-nav a,
	.language-switcher a,
	.text-link {
		text-underline-offset: 0.2em;
	}

	.language-switcher a[aria-current='page'] {
		color: var(--color-text);
		font-weight: 700;
		text-decoration: none;
	}

	.hero,
	.content-section {
		display: grid;
		gap: 1rem;
	}

	.hero {
		margin-bottom: 3rem;
	}

	.eyebrow {
		margin: 0;
		color: var(--color-muted);
		font-size: 0.85rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	h1,
	h2,
	p {
		margin-top: 0;
	}

	h1 {
		max-width: 12ch;
		font-size: clamp(2.25rem, 8vw, 5rem);
		line-height: 0.95;
	}

	h2 {
		line-height: 1.2;
	}

	.project-list {
		display: grid;
		gap: 1rem;
	}

	.project-card {
		display: grid;
		gap: 0.5rem;
		padding: 1rem 0;
		border-top: 1px solid var(--color-line);
	}

	.project-card__meta,
	.project-meta {
		color: var(--color-muted);
	}

	.project-meta {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
		gap: 1rem;
		padding: 1rem 0;
		border-top: 1px solid var(--color-line);
		border-bottom: 1px solid var(--color-line);
	}

	@media (max-width: 48rem) {
		.site-header {
			grid-template-columns: 1fr;
		}
	}
</style>
